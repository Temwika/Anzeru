    { "name": "Approvals",  "url": "/app/approvals-page",           "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Repayments", "url": "/app/payments",                 "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
