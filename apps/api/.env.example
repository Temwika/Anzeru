# Leave DATABASE_URL empty to use the embedded PGlite database in ./.data (development only).
DATABASE_URL=
# DATABASE_URL=postgres://anzelu:anzelu@localhost:5432/anzelu
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Shared secret used to verify mobile-money webhook signatures (HMAC-SHA256).
MOMO_WEBHOOK_SECRET=change-me
# Seed demo data automatically when the database is empty.
SEED_DEMO=true
DOCUMENT_STORAGE_DIR=./storage
